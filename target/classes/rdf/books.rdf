<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:bookrec="http://www.semanticweb.org/bookrec#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="http://www.semanticweb.org/bookrec#"/>
  <owl:Class rdf:about="http://www.semanticweb.org/bookrec#Book"/>
  <owl:Class rdf:about="http://www.semanticweb.org/bookrec#User"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#prefersGenre"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#title"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#hasUserLevel"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#hasGenre"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#hasReadingLevel"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#author"/>
  <rdf:Property rdf:about="http://www.semanticweb.org/bookrec#isRecommendedFor"/>
  <bookrec:Book rdf:about="http://www.semanticweb.org/bookrec#Dune">
    <bookrec:title>Dune</bookrec:title>
    <bookrec:author>Frank Herbert</bookrec:author>
    <bookrec:hasGenre>Science Fiction</bookrec:hasGenre>
    <bookrec:hasGenre>Fantasy</bookrec:hasGenre>
    <bookrec:hasReadingLevel>Advanced</bookrec:hasReadingLevel>
  </bookrec:Book>
  <bookrec:Book rdf:about="http://www.semanticweb.org/bookrec#HungerGames">
    <bookrec:hasGenre>Fantasy</bookrec:hasGenre>
    <bookrec:hasGenre>Science Fiction</bookrec:hasGenre>
    <bookrec:hasReadingLevel>Intermediate</bookrec:hasReadingLevel>
    <bookrec:author>Suzanne Collins</bookrec:author>
    <bookrec:title>Hunger Games</bookrec:title>
    <bookrec:isRecommendedFor>
      <bookrec:User rdf:about="http://www.semanticweb.org/bookrec#Bob">
        <bookrec:hasUserLevel>Beginner</bookrec:hasUserLevel>
        <bookrec:prefersGenre>Mystery</bookrec:prefersGenre>
      </bookrec:User>
    </bookrec:isRecommendedFor>
  </bookrec:Book>
  <bookrec:Book rdf:about="http://www.semanticweb.org/bookrec#HarryPotter">
    <bookrec:title>Harry Potter</bookrec:title>
    <bookrec:author>J.K. Rowling</bookrec:author>
    <bookrec:hasReadingLevel>Beginner</bookrec:hasReadingLevel>
    <bookrec:hasGenre>Fantasy</bookrec:hasGenre>
    <bookrec:hasGenre>Adventure</bookrec:hasGenre>
  </bookrec:Book>
  <bookrec:Book rdf:about="http://www.semanticweb.org/bookrec#TheSilentPatient">
    <bookrec:title>The Silent Patient</bookrec:title>
    <bookrec:author>Alex Michaelides</bookrec:author>
    <bookrec:hasGenre>Mystery</bookrec:hasGenre>
    <bookrec:hasGenre>Murder</bookrec:hasGenre>
    <bookrec:hasReadingLevel>Intermediate</bookrec:hasReadingLevel>
  </bookrec:Book>
  <bookrec:User rdf:about="http://www.semanticweb.org/bookrec#Alice">
    <bookrec:hasUserLevel>Intermediate</bookrec:hasUserLevel>
    <bookrec:prefersGenre>Science Fiction</bookrec:prefersGenre>
  </bookrec:User>
</rdf:RDF>
